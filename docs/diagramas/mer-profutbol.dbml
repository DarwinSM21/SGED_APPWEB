// https://dbdiagram.io/d
// SGED ProFutbol - Entity-Relationship Diagram (conceptual model)
// Engine: PostgreSQL 16
//
// NOTE (E3, Rubrica_ExamenFinal_SGED.pdf): table and column names here
// are the ENGLISH conceptual labels used for this diagram. The real
// database columns stay in Spanish on purpose (@Column mappings are
// protected, since they are the actual production schema) - this
// diagram is documentation, not a 1:1 mirror of physical column names.

// ============================================
// BASE TABLES
// ============================================

Table Person {
  id_person INTEGER [pk, increment]
  first_name VARCHAR(100) [not null]
  last_name VARCHAR(100) [not null]
  id_number CHAR(10) [not null, unique]
  email VARCHAR(200) [not null]
  phone CHAR(10) [not null]
  address VARCHAR(255) [not null]
  birth_date DATE [not null]
  photo TEXT
}

Table Role {
  id_role INTEGER [pk, increment]
  name VARCHAR(255) [not null]
  description TEXT [not null]
}

Table Position {
  id_position INTEGER [pk, increment]
  name VARCHAR(255) [not null]
  description TEXT [not null]
}

Table EvaluationCriterion {
  id_criterion INTEGER [pk, unique]
  name VARCHAR(255)
  description TEXT
  max_score INTEGER
  status VARCHAR(255)
}

Table Equipment {
  id_equipment INTEGER [pk, increment]
  name VARCHAR(255)
  category VARCHAR(255)
  total_quantity INTEGER
  available_quantity INTEGER
  status VARCHAR(255)
  description TEXT
}

// ============================================
// ROLES / STAFF
// ============================================

Table Administrator {
  id_administrator INTEGER [pk, increment]
  id_person INTEGER [not null, ref: > Person.id_person]
  id_role INTEGER [not null, ref: > Role.id_role]
  hire_date DATE [not null]
  status BOOLEAN
}

Table Receptionist {
  id_receptionist INTEGER [pk, increment]
  id_person INTEGER [not null, ref: > Person.id_person]
  id_role INTEGER [not null, ref: > Role.id_role]
  hire_date DATE [not null]
  status BOOLEAN [not null]
}

Table Coach {
  id_coach INTEGER [pk, increment]
  id_person INTEGER [not null, ref: > Person.id_person]
  id_role INTEGER [not null, ref: > Role.id_role]
  specialty VARCHAR(255) [not null]
}

// ============================================
// STUDENTS
// ============================================

Table Student {
  id_student INTEGER [pk, increment]
  id_person INTEGER [not null, ref: > Person.id_person]
  id_position INTEGER [not null, ref: > Position.id_position]
  category VARCHAR(25)
  enrollment_date DATE
  status VARCHAR(100)
  rfid_code TEXT
}

// ============================================
// TRAINING
// ============================================

Table TrainingSchedule {
  id_schedule INTEGER [pk, increment]
  id_coach INTEGER [not null, ref: > Coach.id_coach]
  weekday VARCHAR(100) [not null]
  start_time TIME [not null]
  end_time TIME [not null]
  field TEXT
  description TEXT
  status BOOLEAN
}

Table TrainingSession {
  id_session INTEGER [pk, increment]
  id_schedule INTEGER [ref: > TrainingSchedule.id_schedule]
  id_coach INTEGER [ref: > Coach.id_coach]
  start_time TIME
  end_time TIME
  field TEXT
  status VARCHAR(100)
}

// ============================================
// ATTENDANCE
// ============================================

Table Attendance {
  id_attendance INTEGER [pk, increment]
  id_session INTEGER [ref: > TrainingSession.id_session]
  id_student INTEGER [ref: > Student.id_student]
  check_in_time TIME
  method VARCHAR(255)
  status VARCHAR(55)
}

// ============================================
// EVALUATIONS
// ============================================

Table DailyEvaluation {
  id_evaluation INTEGER [pk, increment]
  id_session INTEGER [not null, ref: > TrainingSession.id_session]
  id_coach INTEGER [not null, ref: > Coach.id_coach]
  date DATE [not null]
  general_observation TEXT
}

Table EvaluationDetail {
  id_detail INTEGER [pk, increment]
  id_evaluation INTEGER [ref: > DailyEvaluation.id_evaluation]
  id_student INTEGER [ref: > Student.id_student]
  id_criterion INTEGER [ref: > EvaluationCriterion.id_criterion]
  id_position_played INTEGER [ref: > Position.id_position]
  score INTEGER
  total_average INTEGER
}

Table StudentObservation {
  id_observation INTEGER [pk, increment]
  id_detail INTEGER [ref: > EvaluationDetail.id_detail]
  id_student INTEGER [ref: > Student.id_student]
  id_coach INTEGER [ref: > Coach.id_coach]
  text TEXT
  date DATE
}

// ============================================
// INJURIES
// ============================================

Table Injury {
  id_injury INTEGER [pk, increment]
  id_student INTEGER [ref: > Student.id_student]
  id_coach INTEGER [ref: > Coach.id_coach]
  type VARCHAR(255)
  severity VARCHAR(255)
  description TEXT
  start_date DATE
  end_date DATE
  status VARCHAR(255)
}

// ============================================
// MATCHES
// ============================================

Table Match {
  id_match INTEGER [pk, increment]
  id_coach INTEGER [ref: > Coach.id_coach]
  opponent VARCHAR(255)
  date DATE
  time TIME
  venue VARCHAR(255)
  type VARCHAR(255)
  own_score VARCHAR(255)
  opponent_score VARCHAR(255)
  status VARCHAR(255)
}

Table MatchLineup {
  id_lineup INTEGER [pk, increment]
  id_match INTEGER [ref: > Match.id_match]
  id_coach INTEGER [ref: > Coach.id_coach]
  ai_generated BOOLEAN
  formation VARCHAR(255)
  generation_date DATE
  status VARCHAR(255)
}

Table LineupPlayer {
  id_lineup_player INTEGER [pk, increment]
  id_lineup INTEGER [ref: > MatchLineup.id_lineup]
  id_position INTEGER [ref: > Position.id_position]
  starter BOOLEAN
  id_student INTEGER [ref: > Student.id_student]
}

Table MatchStatistic {
  id_statistic INTEGER [pk, increment]
  id_match INTEGER [ref: > Match.id_match]
  id_student INTEGER [ref: > Student.id_student]
  goals INTEGER
  assists INTEGER
  shots INTEGER
  fouls INTEGER
  yellow_cards BOOLEAN
  red_cards BOOLEAN
  minutes_played DECIMAL
}

// ============================================
// MEMBERSHIPS AND PAYMENTS
// ============================================

Table Membership {
  id_membership INTEGER [pk, increment]
  id_student INTEGER [not null, ref: > Student.id_student]
  start_date DATE
  end_date DATE
  total_amount DECIMAL
  status VARCHAR(255)
}

Table Payments {
  id_payment INTEGER [pk, increment]
  id_membership INTEGER [ref: > Membership.id_membership]
  id_receptionist INTEGER [ref: > Receptionist.id_receptionist]
  amount_paid DECIMAL
  pending_balance DECIMAL
  payment_method VARCHAR(255)
  payment_date DATE
  observation TEXT
}

// ============================================
// EQUIPMENT LOANS
// ============================================

Table EquipmentLoan {
  id_loan INTEGER [pk, increment]
  id_equipment INTEGER [ref: > Equipment.id_equipment]
  id_student INTEGER [ref: > Student.id_student]
  id_receptionist INTEGER [ref: > Receptionist.id_receptionist]
  loan_date DATE
  expected_return_date DATE
  actual_return_date DATE
  status VARCHAR(255)
  observation TEXT
}

// ============================================
// REPORTS AND NOTIFICATIONS
// ============================================

Table Report {
  id_report INTEGER [pk, increment]
  id_user INTEGER [ref: > Person.id_person]
  type VARCHAR(255)
  generation_date DATE
  format TEXT
  file_path TEXT
}

Table Notification {
  id_notification INTEGER [pk, increment]
  id_user INTEGER [ref: > Person.id_person]
  title VARCHAR(255)
  message TEXT
  type VARCHAR(255)
  sent_date DATE
  read BOOLEAN
}
