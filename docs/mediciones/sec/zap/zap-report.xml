						<alert>Cross-Origin-Embedder-Policy Header Missing or Invalid</alert>
						<name>Cross-Origin-Embedder-Policy Header Missing or Invalid</name>
						<riskcode>1</riskcode>
						<confidence>2</confidence>
						<riskdesc>Low (Medium)</riskdesc>
						<confidencedesc>Medium</confidencedesc>
						<desc>&lt;p&gt;Cross-Origin-Embedder-Policy header is a response header that prevents a document from loading any cross-origin resources that don&apos;t explicitly grant the document permission (using CORP or CORS).&lt;/p&gt;</desc>
						<instances>
							
								<instance>
									<uri>http://host.docker.internal:8080/api/docs</uri>
									<nodeName>http://host.docker.internal:8080/api/docs</nodeName>
									<method>GET</method>
