# ==============================================================
# SGED - Variables de Entorno (Plantilla de Configuración)
# Instrucciones:
# 1. Copie este archivo como .env: cp .env.example .env
# 2. Reemplace los valores marcados con 'cambiar_en_produccion' o 'changeme'.
# ==============================================================

# ==========================
# Base de Datos PostgreSQL
# ==========================
# Opción 1: Desarrollo Local / Docker Compose
# `make up` monta db/schema.sql + db/seed.sql en /docker-entrypoint-initdb.d/
# (solo corre en un volumen nuevo/vacío) y el backend arranca con
# FLYWAY_ENABLED=false porque el esquema ya está aplicado. Para correr el
# backend suelto (IDE / start-local.bat) contra un Postgres local sin ese
# volumen, usar en cambio FLYWAY_ENABLED=true más abajo: Flyway aplica
# V1..V15 solo, sin pasos manuales.
# DB_URL=jdbc:postgresql://postgres:5432/sged_db?prepareThreshold=0&preparedStatementCacheQueries=0
# DB_USER=postgres
# DB_PASSWORD=changeme

# Opción 2: Supabase (Transaction Pooler, puerto 6543 — uso normal de la app)
# NOTA: prepareThreshold=0 no es solo por PgBouncer — sin él, Hibernate 6 +
# pgjdbc pueden fallar con "could not determine data type of parameter" (o
# "cannot cast type bytea to date") en cualquier consulta con parámetros
# opcionales tipo "(:x IS NULL OR columna >= :x)" sobre columnas de fecha,
# también contra Postgres local sin PgBouncer de por medio. Por eso va en
# las dos opciones de arriba, no solo en Supabase.
DB_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&preparedStatementCacheQueries=0

DB_USER=postgres.tu_id_de_proyecto
DB_PASSWORD=tu_contrasena_de_supabase_aqui

# Solo con Supabase + FLYWAY_ENABLED=true: el Transaction Pooler (6543) no
# sostiene los advisory locks de sesión que Flyway necesita para migrar.
# Apuntar estas tres variables al Session Pooler (mismo host, puerto 5432)
# o a la conexión directa, dejando DB_URL de arriba en 6543 para la app.
# Sin esto, Flyway usa DB_URL para todo (comportamiento de Docker/local).
# FLYWAY_DB_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:5432/postgres
# FLYWAY_DB_USER=postgres.tu_id_de_proyecto
# FLYWAY_DB_PASSWORD=tu_contrasena_de_supabase_aqui

# ==========================
# Usuario Inicial Administrador (Seeding)
# ==========================
USUARIO_ADMIN=admin
CONTRASENA_ADMIN=Admin123456*

# ==========================
# Redis
# ==========================
# Usar 'redis' si la app corre dentro de Docker Compose.
# Usar 'localhost' si ejecutas la app localmente con 'mvn spring-boot:run'.
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================
# JWT (RFC 7519)
# ==========================
# Mínimo 32 caracteres. CAMBIAR obligatoriamente en entornos de producción.
JWT_SECRET=SGED_2026_SECRET_KEY_MUY_LARGA_Y_SEGURA_123456789
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=sged-backend
JWT_AUDIENCE=sged-frontend

# ==========================
# Cookies y Seguridad
# ==========================
# Marca las cookies de sesion como Secure. Dejarlo en true: los navegadores
# tratan http://localhost como origen confiable y aceptan cookies Secure ahi,
# asi que NO hace falta ponerlo en false para desarrollar.
#
# El unico caso que se rompe es entrar por HTTP plano desde otro dispositivo
# -por ejemplo el celular contra http://192.168.x.x:4200 para probar el QR-.
# Para eso conviene usar la URL publica con HTTPS (ver docs/despliegue/), que
# ademas es mas parecida al uso real.
COOKIE_SECURE=true

# ==========================
# CORS
# ==========================
# Origenes permitidos para llamar a /api/**. Admite "*" en un segmento
# (setAllowedOriginPatterns, no setAllowedOrigins), asi que se puede cubrir
# una subred completa en vez de fijar una IP exacta que cambia por DHCP.
# Para probar desde el celular en la misma red WiFi, agrega tu propia IP
# de LAN (ver `ipconfig` / `ip addr`) sin quitar los localhost por defecto,
# por ejemplo: ...,https://192.168.1.*:8443,http://192.168.1.*:4200
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200,http://localhost:80,http://127.0.0.1:4200,http://localhost:5173

# ==========================
# Rate Limiting Login (OWASP A07)
# ==========================
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# ==========================
# Caché y Migraciones
# ==========================
# TTL externo de caché en segundos
CACHE_TTL_SECONDS=60

# Habilitar Flyway si se gestionan migraciones de BD desde la app
FLYWAY_ENABLED=true

# ==========================
# Generación de texto con IA (módulo Entrenador)
# ==========================
# Deshabilitada por defecto: el sistema funciona completo sin ella.
# Si el modelo no responde, la evaluación se guarda igual y el comentario
# simplemente no aparece.
IA_HABILITADO=false

# Clave de Google AI Studio. NUNCA committear la real: va en .env, que está
# en .gitignore. Se envía en la cabecera x-goog-api-key, no en la URL.
GEMINI_API_KEY=

# Verificar en ai.google.dev qué modelo tiene nivel gratuito vigente antes
# de cambiarlo: solo las variantes Flash y Flash-Lite lo tienen.
# gemini-2.0-flash y gemini-2.0-flash-lite ya NO tienen nivel gratuito para
# keys nuevas (confirmado 2026-08-07: 429 RESOURCE_EXHAUSTED, limit 0, con
# tres keys distintas en cuentas distintas). gemini-flash-latest si funciona.
GEMINI_MODELO=gemini-flash-latest

# Timeout corto, pero con margen: el entrenador califica desde el celular
# en la cancha, y los modelos "-latest" actuales piensan antes de
# responder (~5s medidos en la practica solo para esa parte). 8s quedaba
# demasiado ajustado y podia cortar la respuesta en una red mas lenta.
IA_TIMEOUT_SEGUNDOS=15
