# ==============================================================
# SGED - Variables de Entorno (Plantilla de Configuración)
# Instrucciones:
# 1. Copie este archivo como .env: cp .env.example .env
# 2. Reemplace los valores marcados con 'cambiar_en_produccion' o 'changeme'.
# ==============================================================

# ==========================
# Base de Datos PostgreSQL
# ==========================
# Opción 1: Desarrollo Local (Docker Compose)
# DB_URL=jdbc:postgresql://postgres:5432/sged_db

# Opción 2: Supabase (Pooler en puerto 6543)
# NOTA: prepareThreshold=0 es obligatorio con PgBouncer en Supabase para evitar errores de Prepared Statements
DB_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&preparedStatementCacheQueries=0

DB_USER=postgres.tu_id_de_proyecto
DB_PASSWORD=tu_contrasena_de_supabase_aqui

# ==========================
# Usuario Inicial Administrador (Seeding)
# ==========================
USUARIO_ADMIN=admin
CONTRASENA_ADMIN=Admin123456*

# ==========================
# Redis
# ==========================
# Usar 'redis' si la app corre dentro de Docker Compose.
# Usar 'localhost' si ejecutas la app localmente con 'mvn spring-boot:run'.
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================
# JWT (RFC 7519)
# ==========================
# Mínimo 32 caracteres. CAMBIAR obligatoriamente en entornos de producción.
JWT_SECRET=SGED_2026_SECRET_KEY_MUY_LARGA_Y_SEGURA_123456789
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=sged-backend
JWT_AUDIENCE=sged-frontend

# ==========================
# Cookies y Seguridad
# ==========================
# true exige HTTPS. En desarrollo local sin TLS usar false.
COOKIE_SECURE=false

# ==========================
# Rate Limiting Login (OWASP A07)
# ==========================
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# ==========================
# Caché y Migraciones
# ==========================
# TTL externo de caché en segundos
CACHE_TTL_SECONDS=60

# Habilitar Flyway si se gestionan migraciones de BD desde la app
FLYWAY_ENABLED=false

# ==========================
# Generación de texto con IA (módulo Entrenador)
# ==========================
# Deshabilitada por defecto: el sistema funciona completo sin ella.
# Si el modelo no responde, la evaluación se guarda igual y el comentario
# simplemente no aparece.
IA_HABILITADO=false

# Clave de Google AI Studio. NUNCA committear la real: va en .env, que está
# en .gitignore. Se envía en la cabecera x-goog-api-key, no en la URL.
GEMINI_API_KEY=

# Verificar en ai.google.dev qué modelo tiene nivel gratuito vigente antes
# de cambiarlo: solo las variantes Flash y Flash-Lite lo tienen.
# gemini-2.0-flash y gemini-2.0-flash-lite ya NO tienen nivel gratuito para
# keys nuevas (confirmado 2026-08-07: 429 RESOURCE_EXHAUSTED, limit 0, con
# tres keys distintas en cuentas distintas). gemini-flash-latest si funciona.
GEMINI_MODELO=gemini-flash-latest

# Timeout corto, pero con margen: el entrenador califica desde el celular
# en la cancha, y los modelos "-latest" actuales piensan antes de
# responder (~5s medidos en la practica solo para esa parte). 8s quedaba
# demasiado ajustado y podia cortar la respuesta en una red mas lenta.
IA_TIMEOUT_SEGUNDOS=15
