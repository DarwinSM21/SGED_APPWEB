# OBS (Entrega Final): la capa de entidades quedaba en ~27% de cobertura de
# lineas porque JaCoCo contaba los getters/setters/equals/hashCode/builder
# generados por Lombok como codigo de negocio. Con esta marca Lombok anota
# cada metodo generado con @lombok.Generated, y el filtro nativo de JaCoCo
# (0.8.2+, este proyecto usa 0.8.12) lo excluye de la medicion. Lo que queda
# contado es solo la logica escrita a mano (Pago.estaVigente,
# Lesion.estaActiva, Asistencia.habilitaEvaluacion, etc.).
lombok.addLombokGeneratedAnnotation = true

# Este es el unico lombok.config del proyecto: no seguir buscando hacia
# arriba en el arbol de directorios.
config.stopBubbling = true
