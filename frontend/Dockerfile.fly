# Variante de Dockerfile solo para el despliegue en Fly.io. El Dockerfile
# original (usado por docker-compose en desarrollo local) no se toca.
# Diferencia: sin el paso que genera el certificado autofirmado (Fly
# Proxy entrega HTTPS real en su borde, no hace falta), y copia
# nginx.fly.conf en vez de nginx.conf.

# Etapa 1: compilar Angular
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Etapa 2: servir con nginx (HTTP simple; Fly Proxy hace TLS)
FROM nginx:1.25-alpine

COPY nginx.fly.conf /etc/nginx/conf.d/default.conf
# Angular 17+ application builder deja la app en dist/<proyecto>/browser
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
EXPOSE 80
